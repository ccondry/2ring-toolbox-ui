{
  "name": "2ring-toolbox-ui",
  "version": "2026.11.18",
  "description": "dCloud 2Ring Dashboards & Wallboards Instant Demo toolbox UI. Intended to run on toolbox1 and toolbox2 servers in dCloud shared services.",
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "dev": "npm run serve",
    "serve": "rollup -c -w",
    "start": "npm run serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccondry/2ring-toolbox-ui"
  },
  "keywords": [
    "Vue",
    "Rollup"
  ],
  "author": "ccondry <ccondry@cisco.com>",
  "license": "MIT",
  "homepage": "https://github.com/ccondry/2ring-toolbox-ui",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "buefy": "0.9.29",
    "bulma": "0.9.4",
    "vue": "2.7.16",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2",
    "vuex-router-sync": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@rollup/plugin-alias": "4.0.2",
    "@rollup/plugin-commonjs": "23.0.2",
    "@rollup/plugin-json": "5.0.1",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-replace": "5.0.1",
    "cssnano": "5.1.14",
    "esbuild": "^0.25.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^7.20.0",
    "postcss": "^8.5.32",
    "postcss-import": "15.0.0",
    "postcss-nested": "6.0.0",
    "postcss-sort-media-queries": "4.3.0",
    "postcss-url": "^10.1.4",
    "rollup": "2.80.0",
    "rollup-plugin-cleaner": "^1.0.0",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-esbuild": "5.0.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "2.0.1",
    "rollup-plugin-vue": "^5.1.9",
    "sass": "^1.43.4",
    "vue-template-compiler": "2.7.16"
  },
  "overrides": {
    "@vue/component-compiler-utils": {
      "postcss": "$postcss"
    },
    "postcss-modules-sync": {
      "postcss": "$postcss"
    },
    "generic-names": {
      "loader-utils": "^1.4.2"
    },
    "source-map-resolve": {
      "decode-uri-component": "^0.5.1"
    },
    "rollup-plugin-serve": {
      "mime": "^3.0.0"
    }
  }
}
